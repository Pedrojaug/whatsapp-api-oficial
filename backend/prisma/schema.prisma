datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String?   // Nullable — Google OAuth users have no password
  name      String?
  role      String    @default("USER")
  googleId  String?   @unique
  avatarUrl String?
  emailVerified              Boolean   @default(false)
  verificationToken          String?   @unique
  verificationTokenExpiry    DateTime?
  resetPasswordToken         String?   @unique
  resetPasswordTokenExpiry   DateTime?
  onboardingCompleted        Boolean   @default(false)
  planTier                   String    @default("free")
  subscriptionStatus        String    @default("ACTIVE") // ACTIVE, TRIAL, PAST_DUE, CANCELED, SUSPENDED
  subscriptionExpiresAt     DateTime?
  customPriceMonthly        Float?    @default(0)
  maxAccounts               Int       @default(1)
  maxMonthlyMessages        Int       @default(5000)
  paymentMethod             String?   // PIX, CREDIT_CARD, BOLETO, MANUAL
  notes                     String?
  createdById               String?   // ID do admin que cadastrou este colaborador
  accounts       Account[]
  sharedAccounts AccountShare[]
  payments       PaymentRecord[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PaymentRecord {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  status          String    @default("PAID") // PAID, PENDING, FAILED, REFUNDED
  paymentMethod   String    @default("MANUAL") // PIX, CREDIT_CARD, BOLETO, MANUAL
  referencePeriod String?   // Ex: "2026-07"
  paidAt          DateTime? @default(now())
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model Account {
  id            String     @id @default(uuid())
  name          String
  wabaId        String     // WhatsApp Business Account ID
  phoneNumberId String     // Phone Number ID
  accessToken   String     // System User Token
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  templates        Template[]
  messages         Message[]
  contactLists     ContactList[]
  mediaAssets      MediaAsset[]
  whatsappContacts WhatsAppContact[]
  optOuts          OptOut[]
  trackedLinks     TrackedLink[]
  apiKeys          ApiKey[]
  campaigns        Campaign[]
  shares           AccountShare[]
  quickReplies     QuickReply[]

  @@unique([userId, name])
}

model AccountShare {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("ATTENDANT") // ADMIN, MANAGER, ATTENDANT, VIEWER
  createdAt DateTime @default(now())

  @@unique([accountId, userId])
  @@index([userId])
}


model Template {
  id         String   @id @default(uuid())
  metaId     String?  @unique // ID returned by Meta API
  name       String
  language   String   @default("pt_BR")
  category   String
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  components Json     // Holds the structure: body, headers, buttons, etc.
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, name])
}

model Message {
  id             String   @id @default(uuid())
  wamid          String?  @unique // WhatsApp Message ID (e.g. wamid.HBgNNTUxM...)
  to             String   // Recipient phone number (e.g. 5511999999999)
  status         String   @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED, RECEIVED
  direction      String   @default("OUTGOING") // OUTGOING (nós enviamos) ou INCOMING (cliente enviou)
  messageType    String   @default("TEMPLATE") // TEMPLATE, TEXT, IMAGE, VIDEO, DOCUMENT
  body           String?  // Conteúdo textual livre da mensagem
  mediaUrl       String?  // URL de mídias enviadas/recebidas
  errorMessage   String?
  templateName   String?  // Agora opcional para suportar mensagens de texto livre
  variables      Json?    // Sent parameters (variables arrays/objects)
  sentByUserName String?  // Nome do atendente/colaborador que enviou a mensagem
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime?
  retryCount   Int      @default(0)
  nextRetryAt  DateTime?
  // Origem quando a mensagem veio de uma campanha (sem FK: a mensagem continua
  // nos relatórios mesmo se a campanha ou a execução forem excluídas)
  campaignId    String?
  campaignRunId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaignRunId, status])
  @@index([accountId, to, createdAt])
  @@index([accountId, status, createdAt])
  @@index([accountId, direction, createdAt])
  @@index([status, scheduledAt, nextRetryAt, createdAt])
}

model ContactList {
  id        String    @id @default(uuid())
  name      String
  tags      String[]  @default([])
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([accountId, name])
}

model Contact {
  id            String      @id @default(uuid())
  name          String?
  phone         String      // e.g. "5583986241167"
  variables     Json?       // Dynamic fields like ["João", "order_123"]
  contactListId String
  contactList   ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([contactListId])
  @@index([phone])
}

model WhatsAppContact {
  id          String   @id @default(uuid())
  phone       String   // Número normalizado (13 dígitos BR)
  profileName String?  // Nome de perfil do WhatsApp (contacts[].profile.name)
  blacklisted Boolean  @default(false) // Contato movido para a Lista Negra
  isHandled   Boolean  @default(false) // Conversa concluída/atendida
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, phone])
}

model MediaAsset {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  fileData  String?  // Armazena o base64 do arquivo para persistência no Render
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackedLink {
  id          String    @id @default(uuid())
  shortCode   String    @unique
  originalUrl String
  label       String?
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clicks      Int       @default(0)
  lastClickAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([accountId])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

model Campaign {
  id            String        @id @default(uuid())
  name          String
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactListId String?
  templateName  String
  variables     Json?
  mediaUrl      String?
  status        String        @default("DRAFT")
  scheduleType  String        // ONCE, DAILY, WEEKLY, MONTHLY
  scheduleTime  String?       // "HH:MM" UTC
  scheduleDays  Int[]         @default([])
  scheduleDate  DateTime?
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  runCount      Int           @default(0)
  runs          CampaignRun[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([accountId])
  @@index([status, nextRunAt])
}

model CampaignRun {
  id            String    @id @default(uuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status        String    @default("RUNNING")
  messagesSent  Int       @default(0)
  contactsTotal Int       @default(0)
  errorMessage  String?   // motivo quando a execução é barrada (ex.: template exige mídia)
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([campaignId])
}

model OptOut {
  id        String   @id @default(uuid())
  phone     String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reason    String   @default("USER_REQUEST") // USER_REQUEST, MANUAL, KEYWORD
  createdAt DateTime @default(now())

  @@unique([phone, accountId])
  @@index([accountId])
}

model QuickReply {
  id        String   @id @default(uuid())
  title     String
  message   String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

// Catálogo de perfumes da Capitania do Cheiro (200 produtos com embeddings para RAG).
// A tabela é alimentada e lida pelo agente de IA da cliente no n8n, fora deste app;
// fica modelada aqui só para o `prisma db push` do build não apagá-la. Não remover.
model capitania_catalogo {
  id               Int                    @id @default(autoincrement())
  nome             String                 @db.VarChar(255)
  linha            String                 @db.VarChar(100)
  genero           String                 @db.VarChar(50)
  tamanho          String                 @db.VarChar(50)
  preco            Decimal                @db.Decimal(10, 2)
  familia_olfativa String?                @db.VarChar(255)
  notas_topo       String?
  notas_corpo      String?
  notas_fundo      String?
  inspiracao       String?                @db.VarChar(255)
  descricao        String?
  link_site        String?                @db.VarChar(500)
  ativo            Boolean?               @default(true)
  sheet_origem     String?                @db.VarChar(255)
  embedding        Unsupported("vector")?
  created_at       DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?              @default(now()) @db.Timestamptz(6)

  @@unique([nome, tamanho, genero], map: "unique_produto_tamanho_genero")
}
